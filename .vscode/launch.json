{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Train + evaluate (memory and baseline)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Resume (memory and baseline)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--resume"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Memory run only",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--runs", "memory"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Quick smoke test (~1 min)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--max-steps", "200", "--eval-every", "50", "--memory-size", "2000", "--out-dir", "results/smoke"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Resume quick smoke test",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--max-steps", "200", "--eval-every", "50", "--memory-size", "2000", "--out-dir", "results/smoke", "--resume"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Incremental classes (memory insert vs fine-tune)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/incremental.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Incremental quick smoke test (~2 min)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/incremental.py",
            "args": ["--max-steps", "200", "--eval-every", "50", "--memory-size", "2000", "--finetune-steps", "50", "--joint-ckpt", "", "--out-dir", "results/smoke/incremental"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
